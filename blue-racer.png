<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Time Racer Dash</title><style>
*{box-sizing:border-box}html,body{margin:0;height:100%;font-family:Arial,sans-serif;color:#f8fafc;background:#020617;overflow:hidden}.wrap{height:100vh;max-width:1280px;margin:auto;padding:8px;display:grid;grid-template-rows:auto 1fr;gap:8px;background:radial-gradient(circle at 70% 12%,rgba(14,165,233,.24),transparent 25%),linear-gradient(135deg,#020617,#0f172a 56%,#172554)}.top{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;padding:8px 10px;border:2px solid rgba(148,163,184,.45);border-radius:18px;background:rgba(15,23,42,.94)}.top a{text-decoration:none;background:#fff;color:#111827;padding:8px 10px;border-radius:999px;font-weight:bold;font-size:14px}.top h1{margin:0;text-align:center;font-size:24px;letter-spacing:2px;text-transform:uppercase}.pill{background:#facc15;color:#111827;border-radius:999px;padding:8px 12px;font-weight:bold;font-size:14px}.main{min-height:0;display:grid;grid-template-columns:1fr 350px;gap:8px}.race,.garage{min-height:0;border:2px solid rgba(148,163,184,.42);border-radius:22px;background:rgba(15,23,42,.92);padding:8px}.race{display:grid;grid-template-rows:auto 188px 1fr;gap:8px}.row{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.box{padding:6px;border-radius:14px;background:linear-gradient(180deg,#1e293b,#0f172a);border:1px solid rgba(148,163,184,.35);text-align:center}.box span{display:block;font-size:11px;color:#cbd5e1}.box strong{display:block;font-size:22px;color:#fef08a}.lanes{position:relative;border-radius:18px;background:linear-gradient(180deg,#1f2937,#111827);border:3px solid #475569;padding:8px 30px 8px 48px;overflow:hidden}.lane{position:relative;height:50px;border-bottom:2px dashed rgba(248,250,252,.18)}.lane:last-child{border-bottom:none}.name{position:absolute;left:-40px;top:15px;width:36px;font-size:11px;font-weight:bold;color:#e2e8f0;text-align:right}.racer{position:absolute;top:0px;left:-6px;width:92px;height:46px;transition:left .75s ease}.racer svg,.racer img{width:100%;height:100%;object-fit:contain;display:block}.car-sprite{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 8px 10px rgba(0,0,0,.35))}.finish{position:absolute;right:14px;top:8px;bottom:8px;width:14px;background:repeating-linear-gradient(45deg,#fff 0 6px,#111827 6px 12px)}.question{display:grid;grid-template-columns:250px 1fr;gap:10px;align-items:center;border-radius:20px;background:#0b1220;border:1px solid rgba(148,163,184,.35);padding:10px}.clockPanel{display:grid;place-items:center}.clock{width:215px;height:215px;border-radius:50%;background:#f8fafc;border:8px solid #facc15;position:relative}.num{position:absolute;color:#0f172a;font-weight:bold;font-size:17px;left:50%;top:50%;transform:translate(-50%,-50%)}.hand{position:absolute;left:50%;top:50%;transform-origin:50% 100%;border-radius:999px}.hand.hour{width:8px;height:60px;background:#111827;margin-left:-4px;margin-top:-60px}.hand.minute{width:5px;height:84px;background:#334155;margin-left:-2.5px;margin-top:-84px}.pin{position:absolute;left:50%;top:50%;width:16px;height:16px;background:#facc15;border:3px solid #111827;border-radius:50%;transform:translate(-50%,-50%)}.levelTag{display:inline-block;padding:8px 12px;border-radius:999px;background:#1e293b;color:#fef08a;font-weight:bold;margin-bottom:8px}.prompt{margin:2px 0 10px;font-size:21px;font-weight:bold}.answers{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.answers button{padding:14px 12px;border:none;border-radius:14px;background:#38bdf8;color:#06283d;font-size:20px;font-weight:bold;cursor:pointer;box-shadow:inset 0 -3px 0 rgba(0,0,0,.18)}.answers button:disabled{opacity:.72;cursor:default}.feedback{min-height:32px;margin-top:10px;font-size:17px;font-weight:bold}.feedback.correct{color:#86efac}.feedback.wrong{color:#fca5a5}.garage{display:grid;grid-template-rows:auto auto 1fr auto;gap:7px;overflow:hidden}.garage h2{margin:0;text-align:center;color:#fef08a;font-size:21px}.preview{height:116px;border-radius:16px;background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid rgba(148,163,184,.35);display:grid;place-items:center}.preview svg,.preview img{max-height:108px;width:auto;display:block}.preview .car-sprite{filter:drop-shadow(0 10px 12px rgba(0,0,0,.35))}.packs{display:grid;gap:5px;overflow:auto;padding-right:2px}.pack{border:1px solid rgba(148,163,184,.35);border-radius:13px;background:#111827;padding:5px}.pack.unlocked{border-color:#facc15}.head{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center;font-weight:bold;font-size:14px;margin-bottom:5px}.head button{border:none;border-radius:999px;padding:6px 9px;background:#22c55e;color:#fff;font-weight:bold;cursor:pointer;font-size:12px}.head button:disabled{background:#475569;cursor:default}.opts{display:grid;grid-template-columns:repeat(2,1fr);gap:4px}.opt{padding:7px 6px;border-radius:10px;border:1px solid rgba(148,163,184,.35);background:#1e293b;color:#e5e7eb;font-size:11px;font-weight:bold;cursor:pointer;text-align:center;line-height:1.25}.opt.active{border-color:#38bdf8;background:#0f3a54;color:#fff}.opt.locked{opacity:.65}.msg{padding:10px;border-radius:12px;background:#0b1220;border:1px solid rgba(148,163,184,.35);font-size:13px;font-weight:bold;color:#cbd5e1;line-height:1.35}.overlay{position:fixed;inset:0;background:rgba(2,6,23,.75);display:none;place-items:center;padding:16px;z-index:30}.overlay.visible{display:grid}.complete{max-width:460px;width:100%;padding:24px;border-radius:24px;background:#111827;border:2px solid rgba(148,163,184,.45);text-align:center;box-shadow:0 25px 50px rgba(0,0,0,.45)}.complete h2{margin:0 0 10px;color:#fef08a}.big{font-size:58px;margin:8px 0}.complete p{font-size:18px;font-weight:bold;line-height:1.4}.complete button{margin-top:10px;padding:12px 20px;border:none;border-radius:14px;background:#38bdf8;color:#06283d;font-size:18px;font-weight:bold;cursor:pointer}.spark{position:fixed;pointer-events:none;font-size:24px;animation:floatUp 1s ease-out forwards;z-index:40}@keyframes floatUp{0%{opacity:1;transform:translateY(0) scale(.85)}100%{opacity:0;transform:translateY(-65px) scale(1.35)}}@media(max-width:980px){html,body{overflow:auto}.wrap{height:auto;min-height:100vh}.main{grid-template-columns:1fr}.question{grid-template-columns:1fr}.row{grid-template-columns:repeat(2,1fr)}.top{grid-template-columns:1fr}.race{grid-template-rows:auto 188px auto}.packs{overflow:visible}}
</style></head><body><main class="wrap"><header class="top"><a href="index.html">← Start</a><h1>Time Racer Dash</h1><div class="pill">More levels</div></header><section class="main"><section class="race"><div class="row"><div class="box"><span>Level</span><strong id="level">1</strong></div><div class="box"><span>Round</span><strong><span id="round">1</span>/<span id="totalRounds">10</span></strong></div><div class="box"><span>Tokens</span><strong id="tokens">0</strong></div><div class="box"><span>Correct</span><strong id="score">0</strong></div><div class="box"><span>Streak</span><strong id="streak">0</strong></div></div><div class="lanes" id="lanes"><div class="finish"></div></div><div class="question"><div class="clockPanel"><div class="clock" id="clock"></div></div><div class="quiz"><div class="levelTag" id="levelTitle">Level 1</div><p class="prompt">What time is shown?</p><div class="answers" id="answers"></div><div class="feedback" id="feedback"></div></div></div></section><aside class="garage"><h2>Garage</h2><div class="preview" id="preview"></div><div class="packs" id="packs"></div><div class="msg" id="msg">Win races and answer correctly to earn Time Tokens.</div></aside></section></main><div class="overlay" id="overlay"><div class="complete"><h2 id="overlayTitle">Race Complete!</h2><div class="big" id="overlayIcon">🏁</div><p id="overlayText">You finished the race.</p><button id="continueBtn" type="button">Race Again</button></div></div><script>const cars=[{"id": "red", "name": "Red Racer", "img": "assets/red-racer.png"}, {"id": "blue", "name": "Blue Racer", "img": "assets/blue-racer.png"}, {"id": "green", "name": "Green Racer", "img": "assets/green-racer.png"}, {"id": "yellow", "name": "Golden Racer", "img": "assets/yellow-racer.png"}, {"id": "purple", "name": "Purple Racer", "img": "assets/purple-racer.png"}, {"id": "black", "name": "Shadow Racer", "img": "assets/black-racer.png"}];const levels=[{"id": "1", "name": "Level 1: O'clock", "types": ["oclock"], "rounds": 10, "playerStep": 15, "botMin": 4, "botMax": 7}, {"id": "2", "name": "Level 2: Half Past", "types": ["half"], "rounds": 10, "playerStep": 14, "botMin": 5, "botMax": 8}, {"id": "3", "name": "Level 3: Quarter Past", "types": ["quarterpast"], "rounds": 10, "playerStep": 13, "botMin": 5, "botMax": 8}, {"id": "4", "name": "Level 4: Quarter To", "types": ["quarterto"], "rounds": 10, "playerStep": 13, "botMin": 5, "botMax": 9}, {"id": "5", "name": "Level 5: Past and To Mix", "types": ["half", "quarterpast", "quarterto"], "rounds": 12, "playerStep": 12, "botMin": 6, "botMax": 9}, {"id": "6", "name": "Level 6: Five-Minute Times", "types": ["five"], "rounds": 12, "playerStep": 12, "botMin": 6, "botMax": 10}, {"id": "7", "name": "Level 7: Championship Mix", "types": ["oclock", "half", "quarterpast", "quarterto", "five"], "rounds": 14, "playerStep": 11, "botMin": 6, "botMax": 11}];const packs=[{"id": "paint", "name": "Paint Finish", "cost": 4, "options": [{"id": "gloss", "name": "Gloss"}, {"id": "matte", "name": "Matte"}, {"id": "metallic", "name": "Metallic"}, {"id": "carbon", "name": "Carbon bonnet"}]}, {"id": "decals", "name": "Decals", "cost": 5, "options": [{"id": "none", "name": "None"}, {"id": "stripe", "name": "Centre stripe"}, {"id": "number", "name": "Race number"}, {"id": "check", "name": "Chequered band"}, {"id": "bolt", "name": "Lightning decal"}]}, {"id": "rims", "name": "Rims", "cost": 7, "options": [{"id": "stock", "name": "Stock alloy"}, {"id": "six", "name": "Silver 6-spoke"}, {"id": "black", "name": "Black sport"}, {"id": "gold", "name": "Gold race"}]}, {"id": "spoiler", "name": "Spoiler", "cost": 9, "options": [{"id": "none", "name": "None"}, {"id": "lip", "name": "Lip spoiler"}, {"id": "gt", "name": "GT wing"}]}, {"id": "boost", "name": "Boost Trail", "cost": 12, "options": [{"id": "none", "name": "None"}, {"id": "blue", "name": "Blue boost"}, {"id": "flame", "name": "Flame exhaust"}, {"id": "zap", "name": "Electric launch"}]}];
function carSvg(car,sel={}){
  return `<img class="car-sprite" src="${car.img}" alt="${car.name}">`;
}
const $=id=>document.getElementById(id);let params=new URLSearchParams(location.search);let levelIndex=Math.max(0,Math.min(levels.length-1,Number(params.get('level')||'1')-1));let levelData=levels[levelIndex];let carId=params.get('car')||localStorage.getItem('timeRacerCarDash2')||'red';localStorage.setItem('timeRacerCarDash2',carId);let progress=[0,0,0,0],round=1,score=0,streak=0,answered=false,current=null,lastLabel='';const botCars=[cars[2],cars[4],cars[5]];function loadState(){try{const s=JSON.parse(localStorage.getItem('timeRacerDashState2')||'{}');return{tokens:Number(s.tokens||0),unlocked:Array.isArray(s.unlocked)?s.unlocked:[],selected:s.selected&&typeof s.selected==='object'?s.selected:{}}}catch(e){return{tokens:0,unlocked:[],selected:{}}}}let saved=loadState();function saveState(){localStorage.setItem('timeRacerDashState2',JSON.stringify(saved))}function r(a,b){return Math.floor(Math.random()*(b-a+1))+a}function pick(arr){return arr[r(0,arr.length-1)]}function pad(n){return String(n).padStart(2,'0')}function label(h,m){return h+':'+pad(m)}function words(h,m){if(m===0)return h+" o'clock";if(m===15)return 'quarter past '+h;if(m===30)return 'half past '+h;if(m===45)return 'quarter to '+((h%12)+1);return (m<30?m+' past '+h:(60-m)+' to '+((h%12)+1))}function currentCar(){return cars.find(c=>c.id===carId)||cars[0]}function drawLanes(){const lanes=$('lanes');lanes.innerHTML='<div class="finish"></div>';['You','Bot 1','Bot 2','Bot 3'].forEach((n,i)=>{const lane=document.createElement('div');lane.className='lane';lane.innerHTML=`<div class="name">${n}</div><div class="racer ${i===0?'player':''}" id="racer${i}"></div>`;lanes.appendChild(lane)});updateRaceCars()}function updateRaceCars(){const laneCars=[currentCar(),...botCars];for(let i=0;i<4;i++){const el=$('racer'+i);if(!el)continue;el.style.left=`calc(${Math.min(progress[i],96)}% - ${i===0?88:84}px)`;el.innerHTML=i===0?carSvg(laneCars[i],saved.selected):carSvg(laneCars[i],{})}$('preview').innerHTML=carSvg(currentCar(),saved.selected)}function getTimeParts(type){const h=r(1,12);if(type==='oclock')return{h,m:0};if(type==='half')return{h,m:30};if(type==='quarterpast')return{h,m:15};if(type==='quarterto')return{h,m:45};if(type==='five'){const mins=[5,10,20,25,35,40,50,55];return{h,m:pick(mins)}}return{h,m:0}}function makeTime(){let t,h,m,val,tries=0;do{t=pick(levelData.types);const obj=getTimeParts(t);h=obj.h;m=obj.m;val=label(h,m);tries++}while(val===lastLabel&&tries<40);lastLabel=val;return{h,m,label:val,words:words(h,m)}}function possibleMinutes(){const set=new Set();levelData.types.forEach(t=>{if(t==='oclock')set.add(0);if(t==='half')set.add(30);if(t==='quarterpast')set.add(15);if(t==='quarterto')set.add(45);if(t==='five')[5,10,20,25,35,40,50,55].forEach(m=>set.add(m));});return [...set]}function options(correct){const list=[correct.label];const mins=possibleMinutes();while(list.length<4){const candidate=label(r(1,12),pick(mins));if(!list.includes(candidate))list.push(candidate)}return list.sort(()=>Math.random()-0.5)}function drawClock(h,m){const c=$('clock');c.innerHTML='';for(let n=1;n<=12;n++){const d=document.createElement('div');d.className='num';d.textContent=n;const a=(n*30-90)*Math.PI/180;d.style.left=(50+Math.cos(a)*38)+'%';d.style.top=(50+Math.sin(a)*38)+'%';c.appendChild(d)}const hr=document.createElement('div');hr.className='hand hour';hr.style.transform=`rotate(${(h%12)*30+m*0.5}deg)`;const mn=document.createElement('div');mn.className='hand minute';mn.style.transform=`rotate(${m*6}deg)`;const pin=document.createElement('div');pin.className='pin';c.append(hr,mn,pin)}function drawPacks(){$('packs').innerHTML='';packs.forEach(pack=>{const unlocked=saved.unlocked.includes(pack.id);const box=document.createElement('div');box.className='pack'+(unlocked?' unlocked':'');box.innerHTML=`<div class="head"><div>${pack.name}</div><button type="button" ${unlocked||saved.tokens<pack.cost?'disabled':''}>${unlocked?'Owned':pack.cost+' tokens'}</button></div><div class="opts"></div>`;box.querySelector('button').onclick=()=>{if(unlocked||saved.tokens<pack.cost)return;saved.tokens-=pack.cost;saved.unlocked.push(pack.id);const first=pack.options[0].id==='none'&&pack.options[1]?pack.options[1].id:pack.options[0].id;saved.selected[pack.id]=first;saveState();$('msg').textContent=pack.name+' unlocked.';hud()};const optWrap=box.querySelector('.opts');pack.options.forEach(opt=>{const b=document.createElement('button');b.type='button';b.className='opt'+(saved.selected[pack.id]===opt.id?' active':'')+(!unlocked?' locked':'');b.textContent=opt.name;b.onclick=()=>{if(!saved.unlocked.includes(pack.id)){$('msg').textContent='Buy '+pack.name+' first.';return}saved.selected[pack.id]=opt.id;saveState();$('msg').textContent=pack.name+': '+opt.name+' equipped.';hud()};optWrap.appendChild(b)});$('packs').appendChild(box)})}function hud(){$('level').textContent=levelIndex+1;$('round').textContent=round;$('totalRounds').textContent=levelData.rounds;$('tokens').textContent=saved.tokens;$('score').textContent=score;$('streak').textContent=streak;$('levelTitle').textContent=levelData.name;drawPacks();updateRaceCars()}function loadQ(){answered=false;current=makeTime();drawClock(current.h,current.m);$('feedback').textContent='';$('feedback').className='feedback';$('answers').innerHTML='';options(current).forEach(opt=>{const b=document.createElement('button');b.type='button';b.textContent=opt;b.onclick=()=>check(opt);$('answers').appendChild(b)});hud()}function sparkle(){for(let i=0;i<8;i++){const s=document.createElement('div');s.className='spark';s.textContent=['⏱️','🪙','✨','🏁'][r(0,3)];s.style.left=r(12,88)+'vw';s.style.top=r(25,75)+'vh';document.body.appendChild(s);setTimeout(()=>s.remove(),950)}}function moveBots(){for(let i=1;i<4;i++)progress[i]+=r(levelData.botMin,levelData.botMax)}function check(choice){if(answered)return;answered=true;Array.from($('answers').children).forEach(b=>b.disabled=true);if(choice===current.label){score++;streak++;const earn=1+(streak>=3?1:0);saved.tokens+=earn;progress[0]+=levelData.playerStep+(streak>=3?2:0);$('feedback').textContent='Correct! It is '+current.words+'. Your car dashes forward!';$('feedback').className='feedback correct';sparkle()}else{streak=0;progress[0]+=2;$('feedback').textContent='Not quite. The time was '+current.words+' ('+current.label+').';$('feedback').className='feedback wrong'}moveBots();saveState();hud();setTimeout(nextStep,1250)}function nextStep(){const botWin=progress.slice(1).some(p=>p>=100),playerWin=progress[0]>=100;if(playerWin||botWin||round>=levelData.rounds){endRace();return}round++;loadQ()}function endRace(){const maxBot=Math.max(...progress.slice(1));const playerWins=progress[0]>=100||(round>=levelData.rounds&&progress[0]>=maxBot&&score>=Math.ceil(levelData.rounds*0.55));if(playerWins){const bonus=5+levelIndex;saved.tokens+=bonus;saveState();$('overlayTitle').textContent='You Won the Dash!';$('overlayIcon').textContent='🏁';$('overlayText').textContent='You won '+levelData.name+' and earned '+bonus+' bonus Time Tokens.'}else{$('overlayTitle').textContent='Try the Race Again';$('overlayIcon').textContent='⏱️';$('overlayText').textContent='The other racers reached the finish first. Read the clock and dash again!'}$('overlay').classList.add('visible');hud()}function continueGame(){$('overlay').classList.remove('visible');progress=[0,0,0,0];round=1;score=0;streak=0;drawLanes();loadQ()}$('continueBtn').onclick=continueGame;drawLanes();loadQ();</script></body></html>