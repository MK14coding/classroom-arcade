<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Time Racer Dash</title><style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:Arial,sans-serif;color:#f8fafc;background:#050816;padding:48px 12px 18px}body:before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(circle at 78% 10%,rgba(14,165,233,.24),transparent 24%),linear-gradient(135deg,#020617,#111827 58%,#172554)}.back{position:fixed;top:10px;left:10px;background:#fff;color:#0f172a;padding:8px 12px;border-radius:999px;text-decoration:none;font-weight:bold}.shell{max-width:1160px;margin:auto;display:grid;gap:14px}.hero,.panel{border-radius:24px;border:2px solid rgba(148,163,184,.42);background:rgba(15,23,42,.92);padding:16px}.hero{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}h1{margin:0;font-size:46px;letter-spacing:2px;text-transform:uppercase}.hero p{margin:8px 0 0;font-size:18px;font-weight:bold;color:#cbd5e1}.badge{padding:12px 16px;border-radius:16px;background:#facc15;color:#111827;font-weight:bold}.grid{display:grid;grid-template-columns:1fr 1.05fr;gap:14px}h2{margin:0 0 12px;color:#fef08a}.steps{display:grid;gap:8px}.step{padding:10px 12px;border-radius:14px;background:rgba(51,65,85,.8);font-weight:bold;line-height:1.35}.cars{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.carBtn{padding:8px;border-radius:18px;border:2px solid rgba(148,163,184,.5);background:#111827;color:#f8fafc;cursor:pointer;font-weight:bold;display:grid;gap:4px;place-items:center}.carBtn.selected{border-color:#facc15;background:#1e293b}.carBtn svg,.carBtn img{max-width:100%;height:92px;object-fit:contain;display:block}.car-sprite{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 8px 10px rgba(0,0,0,.35))}select,.start{width:100%;margin-top:12px;padding:14px;border-radius:16px;border:2px solid #475569;background:#111827;color:#fff;font-size:18px;font-weight:bold}.start{border:0;background:linear-gradient(135deg,#22c55e,#16a34a);font-size:21px;cursor:pointer}@media(max-width:900px){.hero,.grid{grid-template-columns:1fr}.cars{grid-template-columns:repeat(2,1fr)}h1{font-size:34px}}
</style></head><body><a class="back" href="../index.html">← Back to Arcade</a><main class="shell"><section class="hero"><div><h1>Time Racer Dash</h1><p>Now with more levels, including quarter to and five-minute times.</p></div><div class="badge">🏁 Dash Race</div></section><section class="grid"><div class="panel"><h2>How it Works</h2><div class="steps"><div class="step">🕐 One analogue clock appears each round.</div><div class="step">👆 Tap the matching digital time from four choices.</div><div class="step">🏎️ Correct answers move your car forward.</div><div class="step">🤖 Computer cars race against you.</div><div class="step">🎯 Choose from 7 different levels.</div><div class="step">⏱️ Earn Time Tokens for garage upgrades.</div></div></div><div class="panel"><h2>Choose Your Character Car</h2><div class="cars" id="cars"></div><select id="levelSelect"><option value="1">Level 1: O'clock</option><option value="2">Level 2: Half Past</option><option value="3">Level 3: Quarter Past</option><option value="4">Level 4: Quarter To</option><option value="5">Level 5: Past and To Mix</option><option value="6">Level 6: Five-Minute Times</option><option value="7">Level 7: Championship Mix</option></select><button id="start" class="start" type="button">Start Dash Race 🏁</button></div></section></main><script>const cars=[{"id": "red", "name": "Red Racer", "img": "assets/red-racer.png"}, {"id": "blue", "name": "Blue Racer", "img": "assets/blue-racer.png"}, {"id": "green", "name": "Green Racer", "img": "assets/green-racer.png"}, {"id": "yellow", "name": "Golden Racer", "img": "assets/yellow-racer.png"}, {"id": "purple", "name": "Purple Racer", "img": "assets/purple-racer.png"}, {"id": "black", "name": "Shadow Racer", "img": "assets/black-racer.png"}];let selected=localStorage.getItem('timeRacerCarDash2')||'red';
function carSvg(car,sel={}){
  return `<img class="car-sprite" src="${car.img}" alt="${car.name}">`;
}
function draw(){const wrap=document.getElementById('cars');wrap.innerHTML='';cars.forEach(c=>{const b=document.createElement('button');b.type='button';b.className='carBtn'+(c.id===selected?' selected':'');b.innerHTML=carSvg(c,{})+`<div>${c.name}</div>`;b.onclick=()=>{selected=c.id;localStorage.setItem('timeRacerCarDash2',selected);draw();};wrap.appendChild(b);})}document.getElementById('start').onclick=()=>{const level=document.getElementById('levelSelect').value;localStorage.setItem('timeRacerCarDash2',selected);location.href='game.html?car='+encodeURIComponent(selected)+'&level='+encodeURIComponent(level)};draw();</script></body></html>